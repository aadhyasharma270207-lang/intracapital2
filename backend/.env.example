# Model & Inference configuration (IBM Granite 4.x on Ollama)
GRANITE_MODEL=granite3-dense:8b
OLLAMA_BASE_URL=http://localhost:11434

# Vector DB configuration (Qdrant)
# Use http://localhost:6333 for docker/local service. If offline, the app automatically runs in memory.
QDRANT_URL=http://localhost:6333

# Knowledge Graph configuration (Neo4j)
# Use bolt://localhost:7687 for docker/local service. If offline, the app automatically runs sqlite fallback graph.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# Database Configuration (SQLite initially)
DATABASE_URL=sqlite:///./intracapital.db

# Frontend Config for CORS (do not use wildcard in production)
FRONTEND_URL=http://localhost:5173

# Configuration flags
ENABLE_EXTERNAL_DATA=false
MAX_UPLOAD_SIZE_MB=100
PROJECT_ENV=development
